{
  "name": "yalp",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:desktop": "turbo dev --filter=desktop",
    "dev:web": "turbo dev --filter=web",
    "dev:web:3002": "pnpm --filter web run dev:3002",
    "dev:web:restart": "bash scripts/restart-web-dev.sh",
    "dev:app": "turbo dev --filter=web --filter=mcp-server",
    "dev:mcp": "turbo dev --filter=mcp-server"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "@types/node": "^22.0.0"
  }
}
