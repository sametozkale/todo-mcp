# Yalp environment template (committed). Copy to apps/web/.env.local and fill in secrets.
# Next.js loads .env* only from apps/web/ when you run pnpm dev:web — not from this repo root.
#
# Optional — local MCP server (Cursor / Claude): configure in mcp.json env, not here:
#   YALP_API_KEY=yalp_...
#   YALP_API_BASE_URL=http://localhost:3001
#
# Supabase core
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (no trailing slash): OAuth redirects, Stripe return URLs, MCP config, SEO metadata.
# Production: use the canonical host (www) so MCP / OAuth URLs match what users paste in clients.
# Claude Web remote MCP: https://www.yalp.work/api/mcp/stream — avoid apex-only yalp.work (redirects can break auth).
NEXT_PUBLIC_SITE_URL=https://www.yalp.work

# Optional: Google Search Console HTML tag verification (meta tag content value)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Google Analytics 4 measurement ID (enable cookie consent in production where required)
# NEXT_PUBLIC_GA_ID=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout maps plan_key → these on the server (required on Vercel)
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
# Optional: only if some client code still reads price IDs in the browser
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_LIFETIME_PRICE_ID=

# Optional pepper for hashing Yalp API keys (recommended). Must match between key creation and MCP validation.
# Vercel Production: set once and keep stable. If you change it, users must generate new API keys (old hashes no longer match).
YALP_API_KEY_PEPPER=change-me

# --- Vercel / production checklist (MCP + API keys) ---
# - NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY: same project as Supabase dashboard.
# - YALP_API_KEY_PEPPER: identical to the value used when keys were created (empty string is OK if you never set a pepper).
# - Redeploy after changing env vars. If tools return "Invalid API key", rotate keys after any pepper change.

# WhatsApp Cloud API (Meta) — optional; required for /api/whatsapp/* and webhook
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_BUSINESS_NUMBER=
# Digits only or E.164; wa.me link uses digits-only path.

