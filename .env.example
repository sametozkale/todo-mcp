# Supabase core
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used to generate Add to Cursor config)
NEXT_PUBLIC_SITE_URL=https://todo-mcp-web.vercel.app

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_LIFETIME_PRICE_ID=

# Optional pepper for hashing Yalp API keys (recommended)
YALP_API_KEY_PEPPER=change-me
# Legacy alias (kept for backwards compatibility)
# FLOWDO_API_KEY_PEPPER=change-me

