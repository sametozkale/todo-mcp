# Supabase core
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (no trailing slash): OAuth redirects, Stripe return URLs, MCP config, SEO metadata.
# Production target: https://yalp.ai — set this once DNS is live.
# Until then (e.g. current Vercel deployment): https://todo-mcp-web.vercel.app
NEXT_PUBLIC_SITE_URL=https://yalp.ai

# Optional: Google Search Console HTML tag verification (meta tag content value)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Google Analytics 4 measurement ID (enable cookie consent in production where required)
# NEXT_PUBLIC_GA_ID=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout maps plan_key → these on the server (required on Vercel)
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
# Optional: only if some client code still reads price IDs in the browser
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_LIFETIME_PRICE_ID=

# Optional pepper for hashing Yalp API keys (recommended)
YALP_API_KEY_PEPPER=change-me

