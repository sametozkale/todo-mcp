# Copy to .env.local and fill with values from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin (no trailing slash). Production: https://www.yalp.work
NEXT_PUBLIC_SITE_URL=

# Server-only: MCP tool calls validate API keys with the service role. Required for /api/mcp and /api/mcp/stream.
# SUPABASE_SERVICE_ROLE_KEY=

# Same pepper as production if you test API key hashing locally (optional).
# YALP_API_KEY_PEPPER=

# OAuth for Claude Web MCP (optional separate pepper; falls back to YALP_API_KEY_PEPPER).
# YALP_OAUTH_SECRET_PEPPER=
# YALP_OAUTH_ALLOWED_REDIRECT_URIS=
# YALP_MCP_LEGACY_AUTH_HTTP200=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
